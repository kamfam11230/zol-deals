__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment folders (if you ever create one)
env/
venv/
.venv/

# macOS junk
.DS_Store

# Windows junk
Thumbs.db
desktop.ini

# Editor folders
.vscode/
.idea/
